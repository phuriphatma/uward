# Cloudflare Pages headers (ignored by GitHub Pages — harmless there).

# Content-hashed build assets never change at a given URL → cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and manifest must always revalidate so new deploys ship
# immediately (the SW then takes over and updates everything else).
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Baseline security headers for the whole site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
